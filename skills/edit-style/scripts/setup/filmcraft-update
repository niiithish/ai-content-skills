#!/bin/bash
# craft-update — install/update a storytold *Craft app (FilmCraft, EffectCraft) from its
# latest GitHub release into /opt/<app>.
#
# Usage: filmcraft-update [version] [--check] [--force] [--notes]
#        craft-update <app> [version] [--check] [--force] [--notes]
#   version   install a specific release (e.g. v0.5.0) instead of the latest
#   --check   only report whether an update is available (exit 10 if so)
#   --force   reinstall even if already on that version
#   --notes   show the full release notes, not just the first lines
#
# Trust chain: GitHub release asset -> SHA256SUMS.txt from the same release.
# The root step runs through pkexec (password popup), falling back to sudo -A.
set -euo pipefail

PREFIX=/usr/local

die() { echo "error: $*" >&2; exit 1; }
log() { echo ":: $*"; }

# ---------------------------------------------------------------- root phase
# Invoked as: craft-update --install-root <app> <stagedir> <version>
if [[ "${1:-}" == "--install-root" ]]; then
  [[ $EUID -eq 0 ]] || die "--install-root must run as root"
  APP="$2"; STAGE="$3"; VER="$4"
  DEST=/opt/$APP
  [[ -x "$STAGE/bin/$APP" && -x "$STAGE/bin/$APP-cli" ]] || die "bad stage dir"

  rm -rf "$DEST.new" "$DEST.old"
  mkdir -p "$DEST.new"
  cp -a "$STAGE/bin" "$STAGE/share" "$DEST.new/"
  chown -R root:root "$DEST.new"
  [[ -d $DEST ]] && mv "$DEST" "$DEST.old"
  mv "$DEST.new" "$DEST"
  rm -rf "$DEST.old"

  ln -sfn "$DEST/bin/$APP" "$PREFIX/bin/$APP"
  ln -sfn "$DEST/bin/$APP-cli" "$PREFIX/bin/$APP-cli"
  install -Dm644 "$STAGE/share/applications/ai.storyteller.$APP.desktop" /usr/share/applications/ai.storyteller.$APP.desktop
  install -Dm644 "$STAGE/share/mime/packages/ai.storyteller.$APP.xml" /usr/share/mime/packages/ai.storyteller.$APP.xml
  cp -r "$STAGE/share/icons/hicolor" /usr/share/icons/
  command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -qtf /usr/share/icons/hicolor 2>/dev/null || true
  command -v update-desktop-database >/dev/null && update-desktop-database -q /usr/share/applications 2>/dev/null || true
  command -v update-mime-database >/dev/null && update-mime-database /usr/share/mime 2>/dev/null || true
  exit 0
fi

# ---------------------------------------------------------------- user phase
APP=$(basename "$0"); APP=${APP%-update}
if [[ $APP == craft ]]; then
  APP=${1:-}; [[ -n $APP && $APP != -* ]] || die "usage: craft-update <app> [version] [--check] [--force] [--notes]"
  shift
fi
CHECK_ONLY=0; FORCE=0; NOTES=0; WANT=""
for a in "$@"; do
  case $a in
    --check) CHECK_ONLY=1 ;;
    --force) FORCE=1 ;;
    --notes) NOTES=1 ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option: $a" ;;
    *) WANT=$a ;;
  esac
done

for c in gh jq sha256sum tar; do command -v $c >/dev/null || die "missing command: $c"; done
case $(uname -m) in
  x86_64) ARCH=x86_64 ;;
  aarch64|arm64) ARCH=aarch64 ;;
  *) die "unsupported architecture $(uname -m)" ;;
esac

REPO=storytold/$APP
log "Checking $REPO"
if [[ -n $WANT ]]; then TAG=$WANT; [[ $TAG == v* ]] || TAG=v$TAG; else TAG=""; fi
REL=$(gh release view $TAG -R "$REPO" --json tagName,name,publishedAt,body,url,assets) \
  || die "could not read release ${TAG:-latest} of $REPO"
TAG=$(jq -r .tagName <<<"$REL"); LATEST=${TAG#v}
ASSET=$APP-$LATEST-linux-$ARCH.tar.gz
SIZE=$(jq -r --arg n "$ASSET" '.assets[]|select(.name==$n)|.size' <<<"$REL")
[[ -n $SIZE ]] || die "release $TAG has no $ASSET"

CURRENT=$("$APP-cli" --version 2>/dev/null | awk 'NR==1{print $NF}' || true)
CURRENT=${CURRENT:-none}
echo "   installed: $CURRENT"
echo "   latest:    $LATEST  ($(jq -r '.publishedAt[:10]' <<<"$REL"))"
echo "   release:   $(jq -r .url <<<"$REL")"
echo "   download:  $ASSET  ($(numfmt --to=iec --suffix=B "$SIZE"))"

if [[ $CURRENT == "$LATEST" && $FORCE -eq 0 ]]; then
  log "$APP is up to date."
  exit 0
fi

echo
log "Release notes ($TAG)"
if (( NOTES )); then jq -r .body <<<"$REL" | sed 's/\r$//; s/^/   /'
else jq -r .body <<<"$REL" | sed 's/\r$//; s| in https://github.com/[^ ]*$||' | sed -n '1,25p' | sed 's/^/   /'; echo "   ... (--notes for everything)"; fi
echo

if [[ $CHECK_ONLY -eq 1 ]]; then
  log "Update available: $CURRENT -> $LATEST"
  exit 10
fi

TMP=$(mktemp -d -t "$APP-update.XXXXXX")
trap 'rm -rf "$TMP"' EXIT
chmod 755 "$TMP"

log "Downloading $APP $LATEST"
gh release download "$TAG" -R "$REPO" -D "$TMP" -p "$ASSET" -p SHA256SUMS.txt
log "Verifying SHA256"
(cd "$TMP" && grep -F "  $ASSET" SHA256SUMS.txt | sha256sum -c --quiet -) || die "checksum mismatch for $ASSET"
echo "   OK  $(grep -F "$ASSET" "$TMP/SHA256SUMS.txt" | cut -c1-16)…"

log "Extracting"
mkdir "$TMP/x" && tar -xzf "$TMP/$ASSET" -C "$TMP/x"
STAGE=$(echo "$TMP"/x/*/)
STAGE=${STAGE%/}
[[ -x $STAGE/bin/$APP && -x $STAGE/bin/$APP-cli ]] || die "unexpected archive layout"
cp "$(readlink -f "$0")" "$TMP/self"
chmod -R a+rX "$TMP"

if pgrep -x "$APP" >/dev/null 2>&1; then
  echo "   note: $APP is running; restart it after the update."
fi
if pgrep -f "$APP-cli mcp" >/dev/null 2>&1; then
  echo "   note: a headless '$APP-cli mcp' engine is running (Claude Code MCP); restart Claude Code to pick up $LATEST."
fi

log "Installing to /opt/$APP (authentication required)"
SELF=$TMP/self
if [[ $EUID -eq 0 ]]; then
  bash "$SELF" --install-root "$APP" "$STAGE" "$LATEST"
elif command -v pkexec >/dev/null; then
  pkexec /bin/bash "$SELF" --install-root "$APP" "$STAGE" "$LATEST"
else
  SUDO_ASKPASS=${SUDO_ASKPASS:-$HOME/.local/bin/sudo-askpass} sudo -A /bin/bash "$SELF" --install-root "$APP" "$STAGE" "$LATEST"
fi

log "$APP $("$APP-cli" --version | awk 'NR==1{print $NF}') installed."
